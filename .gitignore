# ==============================================================================
# Sensitive Information, Credentials, and Environment Files
# ==============================================================================
# Environment variable files containing API keys, secrets, and URLs
.env
.env.*
*.env
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Private keys, certificates, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json
serviceAccountKey*.json
token.json
id_rsa*
id_ed25519*
*.id_rsa
*.id_ed25519

# ==============================================================================
# User Data, Databases, and Storage
# ==============================================================================
# SQLite database files and user records (contains passwords, user IDs, queues)
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
waterloo.json
*.sql
*.dump

# Flask instance folder & session storage
instance/
sessions/
*.session
flask_session/
.webassets-cache
.cache/

# ==============================================================================
# Python & Bytecode
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Node.js & Bun Dependencies / Build
# ==============================================================================
node_modules/
bun.lockb
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# Logs and Temporary Files
# ==============================================================================
*.log
*.pid
*.seed
*.tmp
*.temp
tmp/
temp/

# ==============================================================================
# Operating System & IDE Artifacts
# ==============================================================================
# OS metadata (avoids leaking file system paths or user names)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE and Editor configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
